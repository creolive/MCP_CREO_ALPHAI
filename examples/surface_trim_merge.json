          "entities": [
            {
              "type": "rectangle",
              "name": "ra",
              "min": [0.0, 0.0],
              "max": [40.0, 20.0]
            }
          ]
        },
        {
          "op": "surface_fill",
          "label": "join_face_a",
          "sketch": "join_a"
        },
        {
          "op": "sketch",
          "label": "join_b",
          "plane": "XY",
          "entities": [
            {
              "type": "rectangle",
              "name": "rb",
              "min": [30.0, 0.0],
              "max": [70.0, 20.0]
            }
          ]
        },
        {
          "op": "surface_fill",
          "label": "join_face_b",
          "sketch": "join_b"
